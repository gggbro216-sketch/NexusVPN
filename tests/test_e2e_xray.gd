extends TestCase
## End-to-end for the sing-box ⇄ Xray chain (XrayBridge): real Xray servers on
## 127.0.0.1, share links parsed by the app, sing-box client config (mixed
## inbound instead of TUN) + Xray client config generated by ConfigBuilder,
## curl through the chain. Requires NEXUS_SINGBOX_BIN, NEXUS_XRAY_BIN, openssl,
## curl, python3; otherwise SKIPPED.

const U := "b831381d-6324-4d53-ad4f-8cda48b30811"
const DIR := "user://e2e_xray"
const HTTP_PORT := 22100

var _sb := ""
var _xray := ""
var _pids: Array[int] = []
var _tree: SceneTree
var _ok := false
var _enc_client := ""
var _reality_pub := ""
var _cert_sha := ""


func setup(runner: Node) -> void:
	_tree = runner.get_tree()
	_sb = OS.get_environment("NEXUS_SINGBOX_BIN")
	_xray = OS.get_environment("NEXUS_XRAY_BIN")
	if _sb == "" or _xray == "" or OS.execute("which", ["openssl", "curl", "python3"]) != 0:
		return
	DirAccess.make_dir_recursive_absolute(DIR)
	var d := ProjectSettings.globalize_path(DIR)
	FileAccess.open(DIR.path_join("hello.txt"), FileAccess.WRITE).store_string("hello-through-xray")
	var cert := d.path_join("cert.pem")
	var key := d.path_join("key.pem")
	OS.execute("openssl", ["req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes", "-days", "1",
		"-subj", "/CN=test.local", "-addext", "subjectAltName=DNS:test.local", "-keyout", key, "-out", cert], [], true)
	var fp_out := []
	OS.execute("openssl", ["x509", "-in", cert, "-noout", "-fingerprint", "-sha256"], fp_out, true)
	_cert_sha = "".join(fp_out).strip_edges().split("=")[-1].replace(":", "").to_lower()
	# VLESS encryption (ML-KEM-768 hybrid) keys
	var out := []
	OS.execute(_xray, ["vlessenc"], out, true)
	var dec := ""
	for line in "".join(out).split("\n"):
		var l := line.strip_edges()
		if l.begins_with("\"decryption\"") and dec == "":
			dec = l.split("\"")[3]
		elif l.begins_with("\"encryption\"") and _enc_client == "":
			_enc_client = l.split("\"")[3]
	out.clear()
	OS.execute(_xray, ["x25519"], out, true)
	var priv := ""
	for line in "".join(out).split("\n"):
		if line.begins_with("PrivateKey:"):
			priv = line.split(":")[1].strip_edges()
		elif line.begins_with("Password (PublicKey):"):
			_reality_pub = line.split(":")[1].strip_edges()
	var tls := {"certificates": [{"certificateFile": cert, "keyFile": key}], "alpn": ["h2", "http/1.1"]}
	var server := {
		"log": {"loglevel": "warning"},
		"inbounds": [
			{"listen": "127.0.0.1", "port": 22001, "protocol": "vless", "settings": {"clients": [{"id": U}], "decryption": "none"},
				"streamSettings": {"network": "xhttp", "xhttpSettings": {"path": "/xh"}}},
			{"listen": "127.0.0.1", "port": 22002, "protocol": "vless", "settings": {"clients": [{"id": U}], "decryption": "none"},
				"streamSettings": {"network": "xhttp", "security": "tls", "tlsSettings": tls, "xhttpSettings": {"path": "/xt", "mode": "packet-up"}}},
			{"listen": "127.0.0.1", "port": 22003, "protocol": "vless", "settings": {"clients": [{"id": U}], "decryption": dec},
				"streamSettings": {"network": "raw"}},
			{"listen": "127.0.0.1", "port": 22004, "protocol": "vless", "settings": {"clients": [{"id": U}], "decryption": "none"},
				"streamSettings": {"network": "xhttp", "security": "reality", "xhttpSettings": {"path": "/xr"},
					"realitySettings": {"target": "127.0.0.1:22101", "serverNames": ["test.local"], "privateKey": priv, "shortIds": ["0123abcd"]}}},
		],
		# Xray 26 freedom blocks private/loopback targets by default; the test target is on 127.0.0.1.
		"outbounds": [{"protocol": "freedom", "settings": {"finalRules": [{"action": "allow"}]}}],
	}
	var f := FileAccess.open(DIR.path_join("server.json"), FileAccess.WRITE)
	f.store_string(JSON.stringify(server))
	f.close()
	_pids.append(OS.create_process("python3", ["-m", "http.server", str(HTTP_PORT), "--bind", "127.0.0.1", "--directory", d]))
	_pids.append(OS.create_process("openssl", ["s_server", "-accept", "127.0.0.1:22101", "-cert", cert, "-key", key, "-www", "-tls1_3", "-quiet", "-alpn", "h2,http/1.1"]))
	_pids.append(OS.create_process(_xray, ["run", "-c", d.path_join("server.json")]))
	await _tree.create_timer(1.5).timeout
	_ok = true


func teardown() -> void:
	for pid in _pids:
		OS.kill(pid)
	_pids.clear()


func _write(name: String, data: Dictionary) -> String:
	var f := FileAccess.open(DIR.path_join(name), FileAccess.WRITE)
	f.store_string(JsonUtil.stringify(data, "  "))
	f.close()
	return ProjectSettings.globalize_path(DIR.path_join(name))


func _through(link: String, port: int) -> String:
	var r := LinkParser.parse(link)
	if not r.ok:
		return "parse: " + r.error
	var p: ProfileModel = r.profile
	if p.engine != "xray":
		return "expected engine xray, got " + p.engine
	var built := ConfigBuilder.build_test_config([p], Settings.DEFAULTS.duplicate(true))
	if not built.ok or built.xray_config.is_empty():
		return "build: " + str(built.error)
	var cfg: Dictionary = built.config
	(cfg.inbounds as Array).append({"type": "mixed", "tag": "in", "listen": "127.0.0.1", "listen_port": port})
	cfg.route.rules.append({"inbound": ["in"], "outbound": built.tags.keys()[0]})
	cfg.route.erase("auto_detect_interface")
	var xpath := _write("xray_%d.json" % port, built.xray_config)
	var test_out := []
	if OS.execute(_xray, ["run", "-test", "-c", xpath], test_out, true) != 0:
		return "xray rejected config: " + "".join(test_out).right(300)
	var sbpath := _write("sb_%d.json" % port, cfg)
	var p1 := OS.create_process(_xray, ["run", "-c", xpath])
	var p2 := OS.create_process(_sb, ["run", "-c", sbpath])
	await _wait_port(port, 6.0)
	var out := []
	var code := OS.execute("curl", ["-s", "-m", "8", "--noproxy", "", "-x", "socks5h://127.0.0.1:%d" % port, "http://127.0.0.1:%d/hello.txt" % HTTP_PORT], out, true)
	OS.kill(p1)
	OS.kill(p2)
	var body := "".join(out).strip_edges()
	if code != 0 or body != "hello-through-xray":
		return "curl exit %d, body <%s>" % [code, body.substr(0, 80)]
	return ""


## Polls until 127.0.0.1:[param port] accepts connections (processes start asynchronously).
func _wait_port(port: int, timeout_s: float) -> void:
	var deadline := Time.get_ticks_msec() + int(timeout_s * 1000)
	while Time.get_ticks_msec() < deadline:
		var peer := StreamPeerTCP.new()
		peer.connect_to_host("127.0.0.1", port)
		await _tree.create_timer(0.1).timeout
		peer.poll()
		if peer.get_status() == StreamPeerTCP.STATUS_CONNECTED:
			peer.disconnect_from_host()
			await _tree.create_timer(0.3).timeout
			return


func _run(label: String, link: String, port: int) -> void:
	if not _ok:
		skip("NEXUS_SINGBOX_BIN/NEXUS_XRAY_BIN/openssl/curl/python3 not available")
		return
	var err := await _through(link, port)
	check(err == "", "%s: %s" % [label, err])


func test_vless_xhttp_plain() -> void:
	await _run("xhttp", "vless://%s@127.0.0.1:22001?type=xhttp&path=%%2Fxh&mode=auto#x" % U, 22201)


func test_vless_xhttp_tls_packet_up() -> void:
	await _run("xhttp+tls", "vless://%s@127.0.0.1:22002?type=xhttp&security=tls&sni=test.local&pcs=%s&path=%%2Fxt&mode=packet-up#xt" % [U, _cert_sha], 22202)


func test_vless_mlkem_encryption() -> void:
	await _run("vless-encryption", "vless://%s@127.0.0.1:22003?type=tcp&encryption=%s#enc" % [U, _enc_client], 22203)


func test_vless_xhttp_reality() -> void:
	await _run("xhttp+reality", "vless://%s@127.0.0.1:22004?type=xhttp&security=reality&sni=test.local&fp=chrome&pbk=%s&sid=0123abcd&path=%%2Fxr#xr" % [U, _reality_pub], 22204)


func test_unpinned_self_signed_cert_is_rejected() -> void:
	if not _ok:
		skip("tools not available")
		return
	var err := await _through("vless://%s@127.0.0.1:22002?type=xhttp&security=tls&sni=test.local&allowInsecure=1&path=%%2Fxt&mode=packet-up#nopin" % U, 22206)
	check(err != "", "self-signed certificate without pin must fail verification")


func test_wrong_uuid_fails() -> void:
	if not _ok:
		skip("tools not available")
		return
	var err := await _through("vless://00000000-0000-0000-0000-000000000000@127.0.0.1:22001?type=xhttp&path=%2Fxh#bad", 22205)
	check(err != "", "a wrong UUID must not deliver traffic")


func test_chain_uses_authenticated_loopback() -> void:
	var r := LinkParser.parse("vless://%s@x.example.com:443?type=xhttp&security=tls&path=/p#x" % U)
	if not ok_result(r):
		return
	var b := ConfigBuilder.build_vpn_config(r.profile, Settings.DEFAULTS.duplicate(true))
	if not ok_result(b):
		return
	var srv: Dictionary = b.config.outbounds[1]
	eq(srv.type, "socks")
	eq(srv.server, "127.0.0.1")
	check(str(srv.get("password", "")).length() >= 16, "socks hop has a random password")
	eq(b.config.route.rules[0], XrayBridge.singbox_dial_rule(), "dial rule is first")
	var dial: Dictionary = b.config.inbounds[1]
	eq(dial.listen, "127.0.0.1")
	check(dial.users.size() == 1, "dial inbound requires auth")
	var xo: Dictionary = b.xray_config.outbounds[0]
	eq(xo.streamSettings.sockopt.dialerProxy, XrayBridge.DIAL_OUTBOUND_TAG, "Xray dials through sing-box")
	eq(b.xray_config.inbounds[0].settings.auth, "password")
	if _sb != "":
		var path := _write("vpn_check.json", b.config)
		var out := []
		check(OS.execute(_sb, ["check", "-c", path], out, true) == 0, "sing-box check: " + "".join(out))
	if _xray != "":
		var xp := _write("vpn_xray_check.json", b.xray_config)
		var out2 := []
		check(OS.execute(_xray, ["run", "-test", "-c", xp], out2, true) == 0, "xray -test: " + "".join(out2).right(300))
