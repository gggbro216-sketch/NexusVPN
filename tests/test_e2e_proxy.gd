extends TestCase
## End-to-end: real sing-box servers on 127.0.0.1, share links parsed by the
## app, client outbounds generated by ConfigBuilder, a real sing-box client
## (mixed inbound instead of TUN) and curl through it to a local HTTP server.
## Requires NEXUS_SINGBOX_BIN, openssl, curl, python3; otherwise SKIPPED.
## This validates protocol configs end-to-end on the host; it does NOT replace
## testing the Android VpnService on a device.

const U := "b831381d-6324-4d53-ad4f-8cda48b30811"
const DIR := "user://e2e"
const HTTP_PORT := 21100
const REALITY_DEST_PORT := 21101

var _bin := ""
var _pids: Array[int] = []
var _tree: SceneTree
var _ok := false
var _reality_pub := ""
var _ss_key := ""


func setup(runner: Node) -> void:
	_tree = runner.get_tree()
	_bin = OS.get_environment("NEXUS_SINGBOX_BIN")
	if _bin == "" or OS.execute("which", ["openssl", "curl", "python3"]) != 0:
		return
	DirAccess.make_dir_recursive_absolute(DIR)
	var d := ProjectSettings.globalize_path(DIR)
	FileAccess.open(DIR.path_join("hello.txt"), FileAccess.WRITE).store_string("hello-through-proxy")
	var cert := d.path_join("cert.pem")
	var key := d.path_join("key.pem")
	OS.execute("openssl", ["req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes", "-days", "1",
		"-subj", "/CN=test.local", "-addext", "subjectAltName=DNS:test.local", "-keyout", key, "-out", cert], [], true)
	var out := []
	OS.execute(_bin, ["generate", "reality-keypair"], out, true)
	var priv := ""
	for line in "".join(out).split("\n"):
		if line.begins_with("PrivateKey:"):
			priv = line.split(":")[1].strip_edges()
		elif line.begins_with("PublicKey:"):
			_reality_pub = line.split(":")[1].strip_edges()
	_ss_key = Marshalls.raw_to_base64(Crypto.new().generate_random_bytes(32))
	var tls := {"enabled": true, "certificate_path": cert, "key_path": key}
	var server := {
		"log": {"level": "warn"},
		"inbounds": [
			{"type": "vless", "tag": "vless", "listen": "127.0.0.1", "listen_port": 21001, "users": [{"uuid": U}]},
			{"type": "vless", "tag": "reality", "listen": "127.0.0.1", "listen_port": 21002, "users": [{"uuid": U, "flow": "xtls-rprx-vision"}],
				"tls": {"enabled": true, "server_name": "test.local", "reality": {"enabled": true,
					"handshake": {"server": "127.0.0.1", "server_port": REALITY_DEST_PORT}, "private_key": priv, "short_id": ["0123abcd"]}}},
			{"type": "trojan", "tag": "trojan", "listen": "127.0.0.1", "listen_port": 21003, "users": [{"password": "pw"}], "tls": tls},
			{"type": "vmess", "tag": "vmess", "listen": "127.0.0.1", "listen_port": 21004, "users": [{"uuid": U}], "transport": {"type": "ws", "path": "/ws"}},
			{"type": "shadowsocks", "tag": "ss", "listen": "127.0.0.1", "listen_port": 21005, "method": "2022-blake3-aes-256-gcm", "password": _ss_key},
			{"type": "hysteria2", "tag": "hy2", "listen": "127.0.0.1", "listen_port": 21006, "users": [{"password": "pw"}], "tls": tls},
			{"type": "tuic", "tag": "tuic", "listen": "127.0.0.1", "listen_port": 21007, "users": [{"uuid": U, "password": "pw"}],
				"tls": {"enabled": true, "certificate_path": cert, "key_path": key, "alpn": ["h3"]}},
			{"type": "anytls", "tag": "anytls", "listen": "127.0.0.1", "listen_port": 21008, "users": [{"password": "pw"}], "tls": tls},
			{"type": "vless", "tag": "grpc", "listen": "127.0.0.1", "listen_port": 21009, "users": [{"uuid": U}], "transport": {"type": "grpc", "service_name": "svc"}},
			{"type": "vless", "tag": "httpupgrade", "listen": "127.0.0.1", "listen_port": 21010, "users": [{"uuid": U}], "transport": {"type": "httpupgrade", "path": "/up"}},
		],
		"outbounds": [{"type": "direct", "tag": "direct"}],
	}
	_write("server.json", server)
	_pids.append(OS.create_process("python3", ["-m", "http.server", str(HTTP_PORT), "--bind", "127.0.0.1", "--directory", d]))
	_pids.append(OS.create_process("openssl", ["s_server", "-accept", "127.0.0.1:%d" % REALITY_DEST_PORT, "-cert", cert, "-key", key, "-www", "-tls1_3", "-quiet"]))
	_pids.append(OS.create_process(_bin, ["run", "-c", d.path_join("server.json")]))
	await _tree.create_timer(1.5).timeout
	_ok = true


func teardown() -> void:
	for pid in _pids:
		OS.kill(pid)
	_pids.clear()


func _write(name: String, data: Dictionary) -> void:
	var f := FileAccess.open(DIR.path_join(name), FileAccess.WRITE)
	f.store_string(JsonUtil.stringify(data, "  "))
	f.close()


## Parses [param link], builds the client config, runs it and fetches via it.
## Returns "" on success, else the reason.
func _through(link: String, port: int, overrides: Dictionary = {}) -> String:
	var r := LinkParser.parse(link)
	if not r.ok:
		return "parse: " + r.error
	var settings := Settings.DEFAULTS.duplicate(true)
	settings.merge(overrides, true)
	var built := ConfigBuilder.build_test_config([r.profile], settings)
	if not built.ok:
		return "build: " + built.error
	var cfg: Dictionary = built.config
	cfg["inbounds"] = [{"type": "mixed", "tag": "in", "listen": "127.0.0.1", "listen_port": port}]
	cfg.route.final = built.tags.keys()[0]
	cfg.route.erase("auto_detect_interface")
	var name := "client_%d.json" % port
	_write(name, cfg)
	var pid := OS.create_process(_bin, ["run", "-c", ProjectSettings.globalize_path(DIR.path_join(name))])
	await _tree.create_timer(0.8).timeout
	var out := []
	var code := OS.execute("curl", ["-s", "-m", "8", "--noproxy", "", "-x", "socks5h://127.0.0.1:%d" % port, "http://127.0.0.1:%d/hello.txt" % HTTP_PORT], out, true)
	OS.kill(pid)
	var body := "".join(out).strip_edges()
	if code != 0 or body != "hello-through-proxy":
		return "curl exit %d, body <%s>" % [code, body.substr(0, 80)]
	return ""


func _run(label: String, link: String, port: int, overrides: Dictionary = {}) -> void:
	if not _ok:
		skip("NEXUS_SINGBOX_BIN/openssl/curl/python3 not available")
		return
	var err := await _through(link, port, overrides)
	check(err == "", "%s: %s" % [label, err])


func test_vless_tcp() -> void:
	await _run("vless", "vless://%s@127.0.0.1:21001?type=tcp#v" % U, 21201)


func test_vless_reality_vision() -> void:
	await _run("reality", "vless://%s@127.0.0.1:21002?security=reality&sni=test.local&fp=chrome&pbk=%s&sid=0123abcd&flow=xtls-rprx-vision&type=tcp#r" % [U, _reality_pub], 21202)


func test_trojan_tls() -> void:
	await _run("trojan", "trojan://pw@127.0.0.1:21003?sni=test.local&allowInsecure=1#t", 21203)


func test_trojan_tls_with_fragmentation() -> void:
	await _run("trojan+fragment", "trojan://pw@127.0.0.1:21003?sni=test.local&allowInsecure=1#tf", 21213, {"tls_fragment": "both"})


func test_vmess_ws() -> void:
	var j := {"v": "2", "ps": "vm", "add": "127.0.0.1", "port": "21004", "id": U, "aid": "0", "scy": "auto", "net": "ws", "path": "/ws", "tls": ""}
	await _run("vmess-ws", "vmess://" + Marshalls.utf8_to_base64(JSON.stringify(j)), 21204)


func test_shadowsocks_2022() -> void:
	await _run("ss2022", "ss://2022-blake3-aes-256-gcm:%s@127.0.0.1:21005#s" % UriUtil.percent_encode(_ss_key), 21205)


func test_hysteria2() -> void:
	await _run("hy2", "hysteria2://pw@127.0.0.1:21006?sni=test.local&insecure=1#h", 21206)


func test_tuic() -> void:
	await _run("tuic", "tuic://%s:pw@127.0.0.1:21007?sni=test.local&alpn=h3&allow_insecure=1&congestion_control=bbr#t" % U, 21207)


func test_anytls() -> void:
	await _run("anytls", "anytls://pw@127.0.0.1:21008?sni=test.local&insecure=1#a", 21208)


func test_vless_grpc() -> void:
	await _run("grpc", "vless://%s@127.0.0.1:21009?type=grpc&serviceName=svc#g" % U, 21209)


func test_vless_httpupgrade() -> void:
	await _run("httpupgrade", "vless://%s@127.0.0.1:21010?type=httpupgrade&path=%%2Fup#hu" % U, 21210)


func test_wrong_credentials_fail() -> void:
	if not _ok:
		skip("tools not available")
		return
	var err := await _through("trojan://WRONG@127.0.0.1:21003?sni=test.local&allowInsecure=1#bad", 21211)
	check(err != "", "a wrong password must not deliver traffic")
	var err2 := await _through("vless://00000000-0000-0000-0000-000000000000@127.0.0.1:21001#bad", 21212)
	check(err2 != "", "a wrong UUID must not deliver traffic")
