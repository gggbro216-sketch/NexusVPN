static var _cache := {}


## Returns an ImageTexture of the icon at [param size] px (scaled by the UI scale).
static func get_icon(name: String, size: int = 24) -> Texture2D:
	var px := maxi(8, int(round(size * Style.ui_scale_for_icons())))
	var key := "%s@%d" % [name, px]
	if _cache.has(key):
		return _cache[key]
	var path: String = PATHS.get(name, PATHS["info"])
	var svg := "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path fill=\"#ffffff\" d=\"%s\"/></svg>" % path
	var img := Image.new()
	var err := img.load_svg_from_string(svg, float(px) / 24.0)
	if err != OK:
		img = Image.create(px, px, false, Image.FORMAT_RGBA8)
	var tex := ImageTexture.create_from_image(img)
	# Rendered at high resolution, reported at the logical size.
	tex.set_size_override(Vector2i(size, size))
	_cache[key] = tex
	return tex
