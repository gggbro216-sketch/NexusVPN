; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NEXUS VPN"
config/description="VPN client built on Godot Engine and the sing-box network core."
config/version="0.2.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.0627451, 0.0705882, 0.0941176, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

Log="*res://scripts/diagnostics/log_manager.gd"
Bus="*res://scripts/core/event_bus.gd"
Settings="*res://scripts/storage/settings_storage.gd"
Platform="*res://scripts/core/platform.gd"
Profiles="*res://scripts/profiles/profile_manager.gd"
Subscriptions="*res://scripts/subscriptions/subscription_manager.gd"
History="*res://scripts/storage/history_storage.gd"
SingBoxManager="*res://scripts/vpn/singbox_manager.gd"
Latency="*res://scripts/network/latency_tester.gd"
Style="*res://scripts/ui/theme_manager.gd"
Nav="*res://scripts/ui/navigation_manager.gd"
App="*res://scripts/core/app_controller.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

[editor_plugins]

enabled=PackedStringArray("res://addons/android_vpn_bridge/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=10

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0627451, 0.0705882, 0.0941176, 1)
